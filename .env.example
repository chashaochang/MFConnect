# The deployment operator sets the entry. NAS/App users need only this URL.
MF_ENTRY_ORIGIN=https://connect.example.com
# Default: mount config/fullchain.pem and config/privkey.pem. Any issuer works.
MF_TLS_MODE=provided
# Optional automatic TLS: MF_TLS_MODE=acme, provider=cloudflare/alidns/dnspod.
# Only the gateway reads the matching credentials from config/dns.env.
MF_DNS_PROVIDER=

# Optional: change only if host ports or this Docker subnet are occupied.
MF_HTTP_BIND=0.0.0.0:80
MF_HTTPS_BIND=0.0.0.0:443
MF_TUNNEL_PORT=17000
MF_NETWORK_SUBNET=172.31.253.0/28
MF_GATEWAY_IP=172.31.253.2

MF_SERVER_IMAGE=ghcr.io/chashaochang/mfconnect-server:0.7.2-docker.1
MF_GATEWAY_IMAGE=ghcr.io/chashaochang/mfconnect-gateway:0.7.2
