# New deployments need one public HTTPS entry, at any DNS depth.
MF_ENTRY_ORIGIN=https://example.com
# Optional compatibility aliases: preserve these when migrating an old deployment.
MF_API_HOST=
MF_BASE_DOMAIN=
MF_TUNNEL_HOST=
MF_HTTPS_BIND=127.0.0.1:18443
MF_TUNNEL_PORT=17000
# Private container-loopback service forwards; never published to the host.
MF_PROXY_PORT_START=20000
MF_PROXY_PORT_END=20999
# Explicit immediate proxy IPs only; set after inspecting the actual ingress.
MF_TRUSTED_PROXY_IPS=[]
# Compatibility build-context image; new installations use the root Compose template.
MF_IMAGE_TAG=0.8.0-docker.1
# Only this existing principal (or an administrator) can update the cloud server.
MF_UPDATE_OWNER=
# Optional NAS whose authenticated administrators may update this cloud instance.
MF_UPDATE_DEVICE=
# Legacy browser alias (optional); leave empty for new unified deployments.
MF_CONNECT_HOST=
# Create this directory with UID/GID 10001 before starting Compose.
MF_UPDATE_DIRECTORY=./updates
# Self-hosted App installation: no invitation or administrator token in App.
MF_INSTALL_MODE=self_service
MF_INSTALL_DEVICE_LIMIT=10
